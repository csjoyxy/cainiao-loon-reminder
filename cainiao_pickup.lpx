#!name = 菜鸟驿站每日待取提醒
#!desc = 每天下午 17:30 自动检测名下菜鸟驿站/快递柜待取包裹并弹出取件码通知（本机直连官方 H5 MTOP 接口，零第三方服务器，日常零 MitM 零额外耗电）
#!author = csjoyxy
#!homepage = https://github.com/csjoyxy/cainiao-loon-reminder
#!icon = https://pp.myapp.com/ma_icon/0/icon_11551760_1777010595/256
#!source = 3e653122b655a8790840c0655e2c874c7d28f6f37c18a7cc423340df34aa46ce, b7b8a69da9419f7d359d7b2345de85a23c9436a707c1b5d18257c791b8a6ea27
#!system = iOS,iPadOS,macOS
#!system_version = 15
#!loon_version = 3.2.0(733)
#!date = 2026-11-26
#!tag = 快递,菜鸟,定时提醒
#!type = normal

[Argument]
capture_cookie = switch,false,tag=抓取Cookie临时开关（抓完即关）,desc=首次配置时开启（同时打开插件右上角启用MitM），用Safari访问 h5.m.taobao.com 登录一次；收到捕获成功通知后立即关闭本开关与插件MitM，日常0抓包0额外耗电
notify_empty = switch,false,tag=无待取快递也通知,desc=默认关闭（下午 17:30 仅在有待取包裹或登录态失效时通知）；手动运行「立即检测」时无论是否有件都会弹窗反馈
cron_exp = input,"30 17 * * *",tag=每日检测时间(Cron),desc=默认每天下午 17:30 执行（分 时 日 月 周）
open_target = select,"cainiao://desktop/station_code","cainiao://","https://h5.m.taobao.com/mlapp/olist.html?tabCode=waitConfirm",tag=点击通知跳转页面,desc=点击通知时自动复制取件码并打开：菜鸟驿站身份码 / 菜鸟App首页 / 淘宝待收货页
vault_pin = input,"cn-local-v1",tag=本地存储隔离口令,desc=用于派生独立存储Key并加密Cookie，防止Loon内其他第三方脚本读取凭证（可改为任意自定义字符）
manual_cookie = input,"",tag=手动填入Cookie（可选）,desc=留空即可；若填写完整淘宝Cookie字符串则优先使用此项，全程无需开过MitM

[Rule]
# 强制淘宝/菜鸟 H5 接口走国内直连，避免挂全局代理时走海外节点触发异地风控
DOMAIN,h5api.m.taobao.com,DIRECT
DOMAIN,h5.m.taobao.com,DIRECT
DOMAIN,main.m.taobao.com,DIRECT
DOMAIN,my.m.taobao.com,DIRECT
DOMAIN,login.taobao.com,DIRECT
# 阻断上述 3 个 H5 域名的 QUIC(UDP 443)，确保首次开启 MitM 抓 Cookie 时 Safari 不会绕过解密
AND,((DOMAIN,h5api.m.taobao.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,h5.m.taobao.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT
AND,((DOMAIN,main.m.taobao.com),(PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Script]
cron {cron_exp} script-path=https://raw.githubusercontent.com/csjoyxy/cainiao-loon-reminder/main/scripts/cainiao_pickup.js,timeout=25,tag=菜鸟驿站每日待取检测,argument=[{capture_cookie},{notify_empty},{open_target},{vault_pin},{manual_cookie}]
generic script-path=https://raw.githubusercontent.com/csjoyxy/cainiao-loon-reminder/main/scripts/cainiao_pickup.js,timeout=25,tag=立即检测一次待取快递,img-url=shippingbox.fill.system,argument=[{capture_cookie},{notify_empty},{open_target},{vault_pin},{manual_cookie}]
http-request ^https:\/\/(?:h5api\.m\.taobao\.com\/h5\/|(?:h5|main|my)\.m\.taobao\.com\/) script-path=https://raw.githubusercontent.com/csjoyxy/cainiao-loon-reminder/main/scripts/cainiao_pickup.js,requires-body=false,timeout=10,enable={capture_cookie},tag=淘宝H5登录Cookie捕获,argument=[{capture_cookie},{notify_empty},{open_target},{vault_pin},{manual_cookie}]

[Mitm]
hostname = h5api.m.taobao.com, h5.m.taobao.com, main.m.taobao.com, my.m.taobao.com
